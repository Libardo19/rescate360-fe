# Panel web contra el API compartido por túnel (sin levantar el backend en tu PC).
# Uso: npm run dev:tunel
# La URL del túnel cambia cada vez que se reinicia: la actualiza quien tenga el backend
# corriendo (ver docs/CONEXION_TUNEL.md). No lleva claves ni contraseñas.
VITE_API_URL=https://operations-conditions-too-voip.trycloudflare.com
VITE_USE_MOCK=false
