# ─────────────────────────────────────────────────────────────────────────────
# App móvil (Flutter) → conexión con el backend (rescate360-be)
#
# Copiar a .env (cp .env.example .env). Nunca subir .env al repositorio.
# Se le pasa a la app así:  flutter run --dart-define-from-file=.env
# (sin ese flag la app no lee este archivo y usa los valores automáticos de abajo)
# ─────────────────────────────────────────────────────────────────────────────

# URL del API. VACÍA = automática según dónde corre la app:
#   flutter run -d chrome / Windows / simulador iOS → http://localhost:8000
#   emulador Android                                 → http://10.0.2.2:8000 (el localhost de tu PC)
# Llénala SOLO en estos casos:
#   celular físico en la misma Wi-Fi → API_BASE_URL=http://<IP-de-tu-PC>:8000   (ipconfig → IPv4)
#                                      y abrir el puerto 8000 en el firewall de Windows
#   APK para probar en cualquier red → la URL HTTPS pública del API (ver config/demo.json y docs/PRUEBA_MOVIL.md)
API_BASE_URL=

# Teselas del mapa (OpenStreetMap en desarrollo; en producción usar un proveedor: MapTiler, Stadia, etc.)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Línea de emergencias que muestra la app
EMERGENCY_LINE=123

# Requisitos del backend para que la app conecte:
#   - docker compose up -d  en rescate360-be  →  http://localhost:8000/health debe responder {"status":"ok"}
#   - en el .env del backend APP_ENV=local (acepta Flutter Web en cualquier puerto de localhost)
