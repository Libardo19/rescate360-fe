# Copiar a .env y completar. Nunca subir .env al repositorio.
# Se pasa a la app con: flutter run --dart-define-from-file=.env
# Emulador Android -> 10.0.2.2 es el localhost de tu PC. Celular físico -> IP de tu PC en la red (ej. 192.168.1.10).
# En Azure copia aquí el FQDN que imprime deploy.ps1 y compila con --dart-define-from-file=.env
API_BASE_URL=http://10.0.2.2:8000
# Teselas del mapa (OpenStreetMap en desarrollo; en producción usar un proveedor: MapTiler, Stadia, etc.)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EMERGENCY_LINE=123
